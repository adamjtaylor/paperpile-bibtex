  month    =  jun,
  year     =  2011
}

@ARTICLE{Comisar2011-mc,
  title    = "Integrin organization: linking adhesion ligand nanopatterns with
              altered cell responses",
  author   = "Comisar, W A and Mooney, D J and Linderman, J J",
