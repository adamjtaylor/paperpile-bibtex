@ARTICLE{Lou2013-xa,
  title    = "Unusual analyte-matrix adduct ions and mechanism of their
              formation in {MALDI} {TOF} {MS} of benzene-1,3,5-tricarboxamide
              and urea compounds",
  author   = "Lou, Xianwen and Fransen, Michel and Stals, Patrick J M and Mes,
