@ARTICLE{Schuh2010-ec,
  title     = "Effect of matrix elasticity on the maintenance of the
               chondrogenic phenotype",
  author    = "Schuh, Elena and Kramer, Jan and Rohwedel, Jürgen and Notbohm,
