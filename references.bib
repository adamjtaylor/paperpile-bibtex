@ARTICLE{Kaftan2014-gm,
  title    = "Mass spectrometry imaging of surface lipids on intact Drosophila
              melanogaster flies",
  author   = "Kaftan, Filip and Vrkoslav, Vladimir and Kynast, Philipp and
              Kulkarni, Purva and Boecker, Sebastian and Cvacka, Josef and
