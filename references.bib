@ARTICLE{Bratt-Leal2011-oj,
  title     = "Incorporation of biomaterials in multicellular aggregates
               modulates pluripotent stem cell differentiation",
  author    = "Bratt-Leal, Andrés M and Carpenedo, Richard L and Ungrin, Mark D
