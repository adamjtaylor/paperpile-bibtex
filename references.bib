  journal  = "Anal. Chem.",
  volume   =  77,
  number   =  21,
  pages    = "6755--6764",
  abstract = "Desorption electrospray ionization (DESI), an ambient mass
              spectrometry technique, is used for trace detection of the
              explosives trinitrohexahydro-1,3,5-triazine (RDX),
              octahydro-1,3,5,7-tetranitro-1,3,5,7-tetrazocine (HMX),
