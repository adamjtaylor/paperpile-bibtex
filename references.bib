@ARTICLE{Haugh2011-ts,
  title     = "Crosslinking and mechanical properties significantly influence
               cell attachment, proliferation, and migration within collagen
               glycosaminoglycan scaffolds",
  author    = "Haugh, Matthew G and Murphy, Ciara M and McKiernan, Ross C and
