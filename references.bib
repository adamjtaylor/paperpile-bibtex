@ARTICLE{Nunes2014-jc,
  title    = "Queen signals in a stingless bee: suppression of worker ovary
              activation and spatial distribution of active compounds",
  author   = "Nunes, Túlio M and Mateus, Sidnei and Favaris, Arodi P and Amaral,
