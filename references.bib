  year     =  2009
}

@ARTICLE{Bogaerts2009-aw,
  title    = "Automated threshold detection for auditory brainstem responses:
              comparison with visual estimation in a stem cell transplantation
              study",
  author   = "Bogaerts, Sofie and Oleskevich, Sharon and Clements, John D and
