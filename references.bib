@ARTICLE{Masaki2016-hr,
  title     = "Imaging Mass Spectrometry Revealed the Accumulation
               Characteristics of the 2-Nitroimidazole-Based Agent
               “Pimonidazole” in Hypoxia",
  author    = "Masaki, Yukiko and Shimizu, Yoichi and Yoshioka, Takeshi and
