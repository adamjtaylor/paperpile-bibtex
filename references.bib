  author   = "Qutachi, Omar and Shakesheff, Kevin M and Buttery, Lee D K",
  journal  = "J. Control. Release",
  abstract = "Embryoid bodies (EBs) generated from embryonic stem cells are used
              to study processes of differentiation within a three dimensional
              (3D) cell environment. In many instances however, EBs are
