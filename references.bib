@ARTICLE{Miyazaki2008-rb,
  title     = "Recombinant human laminin isoforms can support the
               undifferentiated growth of human embryonic stem cells",
  author    = "Miyazaki, Takamichi and Nakatsuji, Norio and Suemori, Hirofumi
               and Kawasaki, Miwa and Futaki, Sugiko and Hasegawa, Kouichi and
