@ARTICLE{Esteve2017-qp,
  title    = "Mass spectrometry imaging shows major derangements in neurogranin
              and in purine metabolism in the triple-knockout 3 x Tg Alzheimer
              mouse model",
  author   = "Esteve, Clara and Jones, Emrys A and Kell, Douglas B and Boutin,
