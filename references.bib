@ARTICLE{Murray2006-py,
  title     = "Imaging via {LA}-{ICP}-{MS}: assessing cancer biomarkers",
  author    = "Murray, Cliff and Bunch, Josephine and Seuma, Jaume and Cox, Alan
               and Rodgers, Jackie and McLeod, Cameron",
  journal   = "Clin. Cancer Res.",
  publisher = "American Association for Cancer Research",
  volume    =  12,
  number    = "19 Supplement",
  pages     = "A68--A68",
  abstract  = "First AACR International Conference on Molecular Diagnostics in
               Cancer Therapeutic Development, Sep 12-15, 2006 A68
               Immunohistochemical procedures are in widespread use to reveal
               the presence of protein biomarkers implicated in cancer, allowing
               localization and, arguably, quantitation. Current strategies for
               imaging tissue sections are based on chromogenic or fluorogenic
               measurement, both of which approaches have strengths and
               weaknesses. Mass spectroscopy provides a powerful alternative
               strategy for mapping protein distribution in tissue sections.
               MALDI-MS can map proteins and small molecules directly, while
               LA-ICP-MS can be used to map protein distribution provided the
               protein, or an antibody directed against the protein, is suitably
               labeled with, for example a rare earth element or colloidal gold.
               This study presents data from experiments to compare
               immunohistochemistry (IHC) with LA-ICP-MS analysis using
               immunogold staining. Five micron sections of formalin-fixed
               breast cancers and normal breast specimens were immunostained for
               expression of a nuclear (PCNA) antigen and a membrane-associated
               antigen (EMA) using the immunogold method. Some samples were
               further treated with silver solution to enhance detection of
               antigen. The same sections were imaged by light microscopy and
               then by LA-ICP-MS for gold and silver. The results demonstrate
               that while LA-ICP-MS can detect a wider dynamic range of marker
               expression than conventional IHC, currently spatial resolution is
               much lower. However; with its clear potential for multiplexing,
               LA-ICP-MS represents a powerful technology for extracting
               biomarker information from tissue sections. Eventually, mass
               spectrometry is likely to supersede IHC as a preferred protein
               imaging technique.",
  month     =  oct,
  year      =  2006,
  language  = "en"
}

