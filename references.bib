@ARTICLE{Nyadong2009-ip,
  title    = "Desorption electrospray/metastable-induced ionization: a flexible
              multimode ambient ion generation technique",
  author   = "Nyadong, Leonard and Galhena, Asiri S and Fernández, Facundo M",
