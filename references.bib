@ARTICLE{Veselkov2014-kg,
  title     = "Chemo-informatic strategy for imaging mass spectrometry-based
               hyperspectral profiling of lipid signatures in colorectal cancer",
  author    = "Veselkov, Kirill A and Mirnezami, Reza and Strittmatter, Nicole
