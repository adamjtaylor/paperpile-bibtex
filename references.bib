@ARTICLE{Cumpson2016-gt,
  title     = "Multispectral optical imaging combined in situ with {XPS} or
               {ToFSIMS} and principal component analysis",
  author    = "Cumpson, Peter J and Fletcher, Ian W and Burnett, Richard and
