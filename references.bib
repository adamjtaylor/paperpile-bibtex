              blockade. We anticipate that digital cytometry will augment
              single-cell profiling efforts, enabling cost-effective,
              high-throughput tissue characterization without the need for
              antibodies, disaggregation or viable cells.",
  month    =  jul,
  year     =  2019,
  language = "en"
}

@ARTICLE{Hartmann2019-jy,
