@ARTICLE{Tsai2009-qg,
  title     = "Fibronectin modulates the morphology of osteoblast-like cells
               ({MG}-63) on nano-grooved substrates",
  author    = "Tsai, Wei-Bor W B and Ting, Yen-Chung Y C and Yang, Jung-Yen J Y
