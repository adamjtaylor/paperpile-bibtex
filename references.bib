@ARTICLE{Unadkat2011-ig,
  title     = "An algorithm-based topographical biomaterials library to instruct
               cell fate",
  author    = "Unadkat, H V and Hulsman, M and Cornelissen, K and Papenburg, B J
               and Truckenmuller, R K and Carpenter, A E and Wessling, M and
               Post, G F and Uetz, M and Reinders, M J T and Stamatialis, D and
