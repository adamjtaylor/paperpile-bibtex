              potential of using topographical cues to control stem cell
              behaviour in vitro.",
  month    =  jan,
  year     =  2012
}

@ARTICLE{Lu2012-lt,
  title     = "Comparison of decellularization techniques for preparation of
               extracellular matrix scaffolds derived from three-dimensional
               cell culture",
  author    = "Lu, Hongxu H and Hoshiba, Takashi T and Kawazoe, Naoki N and
               Chen, Guoping G",
  journal   = "J. Biomed. Mater. Res. A",
