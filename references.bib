@ARTICLE{Lambert2022-ze,
  title    = "Deep immune phenotyping reveals similarities between aging, Down
              syndrome, and autoimmunity",
  author   = "Lambert, Katharina and Moo, Keagan G and Arnett, Azlann and Goel,
              Gautam and Hu, Alex and Flynn, Kaitlin J and Speake, Cate and
