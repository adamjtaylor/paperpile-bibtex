@ARTICLE{Cloyd2012-os,
  title     = "Characterization of porcine aortic valvular interstitial cell
               'calcified' nodules",
  author    = "Cloyd, Kristy L and El-Hamamsy, Ismail and Boonrungsiman, Suwimon
               and Hedegaard, Martin and Gentleman, Eileen and Sarathchandra,
