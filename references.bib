}

@ARTICLE{Kopp2015-gv,
  title    = "{MALDI}-{MS} and {NanoSIMS} imaging techniques to study
              cnidarian-dinoflagellate symbioses",
  author   = "Kopp, C and Wisztorski, M and Revel, J and Mehiri, M and Dani, V
              and Capron, L and Carette, D and Fournier, I and Massi, L and
