@ARTICLE{LaBonia2017-gj,
  title    = "{iTRAQ} Quantitative Proteomic Profiling and {MALDI}-{MSI} of
              Colon Cancer Spheroids Treated with Combination Chemotherapies in
              a {3D} Printed Fluidic Device",
  author   = "LaBonia, Gabriel J and Ludwig, Katelyn R and Mousseau, C Bruce and
              Hummon, Amanda B",
  journal  = "Anal. Chem.",
  abstract = "For a patient with metastatic colorectal cancer there are limited
              clinical options aside from chemotherapy. Unfortunately, the
              development of new chemotherapeutics is a long and costly process.
              New methods are needed to identify promising drug candidates
              earlier in the drug development process. Most chemotherapies are
              administered to patients in combinations. Here, an in vitro
              platform is used to assess the penetration and metabolism of
              combination chemotherapies in three-dimensional colon cancer cell
              cultures, or spheroids. Colon carcinoma HCT 116 cells were
              cultured and grown into three-dimensional cell culture spheroids.
              These spheroids were then dosed with a common combination
              chemotherapy, FOLFIRI (folinic acid, 5-fluorouracil, and
              irinotecan) in a 3D printed fluidic device. This fluidic device
              allows for the dynamic treatment of spheroids across a
              semipermeable membrane. Following dosing, the spheroids were
