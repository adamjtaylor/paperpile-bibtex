}

@ARTICLE{Ibrahim2017-fu,
  title    = "1,6-Diphenyl-1,3,5-hexatriene ({DPH}) as a Novel Matrix for
              {MALDI} {MS} Imaging of Fatty Acids, Phospholipids, and Sulfatides
              in Brain Tissues",
  author   = "Ibrahim, Hanadi and Jurcic, Kristina and Wang, Jasmine S-H and
