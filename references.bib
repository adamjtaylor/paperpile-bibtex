              than expected. Graphical abstract ᅟ.",
  month    =  sep,
  year     =  2018,
  keywords = "Formalin-fixed paraffin-embedded tissue; Mass spectrometry
              imaging; Metabolites; Multicenter study; Peptides; Ring trial",
  language = "en"
}

@ARTICLE{Porta_Siegel2018-uj,
  title    = "Mass Spectrometry Imaging and Integration with Other Imaging
              Modalities for Greater Molecular Understanding of Biological
              Tissues",
  author   = "Porta Siegel, Tiffany and Hamm, Gregory and Bunch, Josephine and
