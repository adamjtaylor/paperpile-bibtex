@ARTICLE{Lehti2015-fd,
  title    = "Spatial distributions of lipids in atherosclerosis of human
              coronary arteries studied by time-of-flight secondary ion mass
              spectrometry",
  author   = "Lehti, Satu and Sjövall, Peter and Käkelä, Reijo and Mäyränpää,
