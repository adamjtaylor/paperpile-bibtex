@ARTICLE{Wiseman2010-xt,
  title     = "Direct analysis of dried blood spots utilizing desorption
               electrospray ionization ({DESI}) mass spectrometry",
  author    = "Wiseman, Justin M and Evans, Christopher A and Bowen, Chester L
