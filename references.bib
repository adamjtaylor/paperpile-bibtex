@ARTICLE{Tomlinson2014-ps,
  title     = "Using a single, high mass resolution mass spectrometry platform
               to investigate ion suppression effects observed during tissue
               imaging",
  author    = "Tomlinson, Laura and Fuchser, Jens and Fuetterer, Arne and
               Baumert, Mark and Hassall, David G and West, Andrew and Marshall,
