@ARTICLE{Sturtevant2017-oh,
  title    = "Three-dimensional visualization of membrane phospholipid
              distributions in Arabidopsis thaliana seeds: A spatial perspective
              of molecular heterogeneity",
  author   = "Sturtevant, Drew and Duenas, Maria Emilia and Lee, Young-Jin and
