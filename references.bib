  author   = "Gogotsi, Yury and Mattia, Davide",
  journal  = "Microfluid. Nanofluidics",
  volume   =  5,
  number   =  3,
  pages    = "289--305",
  abstract = "This review deals with the static and dynamic behavior of liquids
