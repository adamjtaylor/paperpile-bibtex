@ARTICLE{Zhang2008-no,
  title     = "A biodegradable, immunoprotective, dual nanoporous capsule for
               cell-based therapies",
  author    = "Zhang, Xulang and Yen, Chi and Ho, Wiston and Lee, L James and
               He, Hongyan",
  journal   = "Biomaterials",
