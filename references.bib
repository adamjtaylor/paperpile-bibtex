@ARTICLE{Janesick2022-al,
  title    = "High resolution mapping of the breast cancer tumor
              microenvironment using integrated single cell, spatial and in situ
              analysis of {FFPE} tissue",
  author   = "Janesick, Amanda and Shelansky, Robert and Gottscho, Andrew and
              Wagner, Florian and Rouault, Morgane and Beliakoff, Ghezal and de
