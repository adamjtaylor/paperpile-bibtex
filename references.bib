  author   = "Vitsios, Dimitrios and Petrovski, Slavé",
  journal  = "Am. J. Hum. Genet.",
  volume   =  106,
  number   =  5,
  pages    = "659--678",
  abstract = "Access to large-scale genomics datasets has increased the utility
              of hypothesis-free genome-wide analyses. However, gene signals are
