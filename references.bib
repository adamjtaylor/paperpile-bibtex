@ARTICLE{Cole2016-vi,
  title     = "Abstract 4231: Analysis of {FFPE} treated clinical tissue
               sections obtained from human intraocular malignancy, uveal
               melanoma by mass spectrometry imaging ({MSI})",
  author    = "Cole, Laura M and Mudhar, Hardeep S and Sisley, Karen and Peck,
