@ARTICLE{Takai2006-ax,
  title    = "Substrate modulation of osteoblast adhesion strength, focal
              adhesion kinase activation, and responsiveness to mechanical
              stimuli",
  author   = "Takai, E and Landesberg, Regina and Katz, R W and Hung, C T and
