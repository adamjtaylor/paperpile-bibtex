@ARTICLE{Merenbloom2011-wk,
  title     = "How Hot are Your Ions in {TWAVE} Ion Mobility Spectrometry?",
  author    = "Merenbloom, Samuel I and Flick, Tawnya G and Williams, Evan R",
  journal   = "J. Am. Soc. Mass Spectrom.",
