@ARTICLE{Hines2016-oq,
  title     = "Evaluation of Collision Cross Section Calibrants for Structural
               Analysis of Lipids by Traveling Wave Ion Mobility-Mass
               Spectrometry",
  author    = "Hines, Kelly M and May, Jody C and McLean, John A and Xu, Libin",
