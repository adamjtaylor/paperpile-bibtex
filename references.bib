@ARTICLE{Zito2002-kt,
  title    = "Advantages of using non-isothermal bioreactors for the enzymatic
              synthesis of antibiotics: The penicillin {G} acylase as enzyme
              model",
  author   = "Zito, E and Bencivenga, U and Schroen, Cgph and Durante, D and
