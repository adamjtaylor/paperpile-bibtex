  month    =  nov,
  year     =  2014,
  language = "en"
}

@ARTICLE{Wei2017-up,
  title     = "Dual-functional bone implants with antibacterial ability and
               osteogenic activity",
  author    = "Wei, Chung-Kai and Ding, Shinn-Jyh",
  journal   = "J. Mater. Chem. B Mater. Biol. Med.",
  publisher = "The Royal Society of Chemistry",
  abstract  = "A growing number of biomaterial-associated infections cause bone
               implant failures in early and long-term applications. In this
               regard, a calcium silicate–gelatine composite bone implant with
               high strength and superior osteogenic activity was coated with a
               layer of Ag, chitosan polysaccharide (CS) or water-soluble
