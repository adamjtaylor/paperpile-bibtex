@ARTICLE{Hansen2016-zu,
  title     = "Aspects of Quantitation in Mass Spectrometry Imaging Investigated
               on Cryo-Sections of Spiked Tissue Homogenates",
  author    = "Hansen, Heidi Toft and Janfelt, Christian",
  journal   = "Anal. Chem.",
