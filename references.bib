@ARTICLE{Nirmal2022-eh,
  title     = "The spatial landscape of progression and immunoediting in primary
               melanoma at single-cell resolution",
  author    = "Nirmal, Ajit J and Maliga, Zoltan and Vallius, Tuulia and
               Quattrochi, Brian and Chen, Alyce A and Jacobson, Connor A and
               Pelletier, Roxanne J and Yapp, Clarence and Arias-Camison, Raquel
