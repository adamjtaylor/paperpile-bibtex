@ARTICLE{Yokoyama2016-vn,
  title     = "Peptide Fragmentation and Surface Structural Analysis by Means of
               {ToF}-{SIMS} Using Large Cluster Ion Sources",
  author    = "Yokoyama, Yuta and Aoyagi, Satoka and Fujii, Makiko and Matsuo,
