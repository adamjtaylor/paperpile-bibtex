@ARTICLE{Todd2007-kt,
  title     = "Cell spreading correlates with calculated {logP} of amino
               acid-modified surfaces",
  author    = "Todd, Simon J and Alexander, Morgan R and Rawsterne, Rachel E and
               Ulijn, Rein V and Gough, Julie E and Rutten, Frank J M and
               Farrar, David",
  journal   = "Acta Biomater.",
  publisher = "Acta Materialia Inc.",
  volume    =  3,
  number    =  5,
  pages     = "715--721",
  abstract  = "The interactions of cells with synthetic surfaces are a critical
               factor in biomaterials design and it would be invaluable if these
               interactions could be precisely controlled and predicted.
               Hydrophobicity or lipophilicity of the surface is commonly used
               to rationalize cell attachment to materials. In the
               pharmaceutical sciences it is common practice to use logP, the
               partitioning coefficient between water and octanol, as a reliable
               indicator of the hydrophobicity or lipophilicity of (drug)
