}

@ARTICLE{Fornai2012-bd,
  title    = "Three-dimensional molecular reconstruction of rat heart with mass
              spectrometry imaging",
  author   = "Fornai, Lara and Angelini, Annalisa and Klinkert, Ivo and Giskes,
              Frans and Kiss, Andras and Eijkel, Gert and Amstalden-van Hove,
