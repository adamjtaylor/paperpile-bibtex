}

@ARTICLE{Longuespee2014-sd,
  title    = "{HFIP} Extraction Followed by {2D} {CTAB}/{SDS}-{PAGE} Separation:
              A New Methodology for Protein Identification from Tissue Sections
              after {MALDI} Mass Spectrometry Profiling for Personalized
