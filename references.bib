@ARTICLE{McDonnell2017-pn,
  title     = "Mass Spectrometry Imaging in Cancer Research: Future Perspectives",
  author    = "McDonnell, L A and Angel, P M and Lou, S and Drake, R R",
  journal   = "Adv. Cancer Res.",
