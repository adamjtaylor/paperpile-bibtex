@ARTICLE{Magnusson2008-xw,
  title    = "Lipid imaging of human skeletal muscle using {TOF}-{SIMS} with
              bismuth cluster ion as a primary ion source",
  author   = "Magnusson, Ylva and Friberg, Peter and Sjövall, Peter and
              Dangardt, Frida and Malmberg, Per and Chen, Yun",
