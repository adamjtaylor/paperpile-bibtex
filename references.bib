@ARTICLE{Rakowska2016-qq,
  title    = "Determination of the sputtering yield of cholesterol using Arn(+)
              and {C60}(+(+)) cluster ions",
  author   = "Rakowska, P D and Seah, M P and Vorng, J-L and Havelund, R and
