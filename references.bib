@ARTICLE{Nair2012-qf,
  title     = "Gene Expression Signatures of Extracellular Matrix and Growth
               Factors during Embryonic Stem Cell Differentiation",
  author    = "Nair, Rekha R and Ngangan, Alyssa V A V and Kemp, Melissa L M L
               and McDevitt, Todd C T C",
  journal   = "PLoS One",
  publisher = "Public Library of Science San Francisco, USA",
  volume    =  7,
  number    =  10,
  pages     = "e42580--e42580",
  abstract  = "Pluripotent stem cells are uniquely capable of differentiating
               into somatic cell derivatives of all three germ lineages,
               therefore holding tremendous promise for developmental biology
               studies and regenerative medicine therapies. Although temporal
               patterns of phenotypic gene expression have been relatively well
               characterized during the course of differentiation, coincident
               patterns of endogenous extracellular matrix (ECM) and growth
