@ARTICLE{Hosseini2020-pj,
  title     = "Focus Quality Assessment of High-Throughput Whole Slide Imaging
               in Digital Pathology",
  author    = "Hosseini, Mahdi S and Brawley-Hayes, Jasper A Z and Zhang,
               Yueyang and Chan, Lyndon and Plataniotis, Konstantinos and
