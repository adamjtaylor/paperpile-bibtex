}

@ARTICLE{Gautrot2012-de,
  title     = "Mimicking normal tissue architecture and perturbation in cancer
               with engineered micro-epidermis",
  author    = "Gautrot, Julien E J E and Wang, Chunming C and Liu, Xin X and
