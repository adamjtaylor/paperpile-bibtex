@ARTICLE{Yamada2009-yp,
  title     = "One-dimensional topography underlies three-dimensional fibrillar
               cell migration",
  author    = "Yamada, Kenneth M and Matsumoto, Kazue and Doyle, Andrew D and
               Wang, Francis W",
  journal   = "J. Cell Biol.",
  publisher = "The Rockefeller University Press",
  volume    =  184,
  number    =  4,
  pages     = "481--490",
  abstract  = "Current concepts of cell migration were established in regular
               two-dimensional (2D) cell culture, but the roles of topography
               are poorly understood for cells migrating in an oriented 3D
               fibrillar extracellular matrix (ECM). We use a novel
               micropatterning technique termed microphotopatterning (microPP)
               to identify functions for 1D fibrillar patterns in 3D cell
               migration. In striking contrast to 2D, cell migration in both 1D
               and 3D is rapid, uniaxial, independent of ECM ligand density, and
               dependent on myosin II contractility and microtubules (MTs). 1D
               and 3D migration are also characterized by an anterior MT bundle
               with a posterior centrosome. We propose that cells migrate
               rapidly through 3D fibrillar matrices by a 1D migratory mechanism
               not mimicked by 2D matrices.",
  month     =  feb,
  year      =  2009
}

@ARTICLE{Li2009-rq,
  title    = "Electrophysiological development of transplanted embryonic stem
              cell-derived cardiomyocytes in the hearts of syngeneic mice",
  author   = "Li, Yan-Hui and Cai, Jun and Yang, Long and Yi, Fang-Fang and
