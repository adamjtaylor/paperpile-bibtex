}

@ARTICLE{Rzagalinski2017-yd,
  title     = "Quantification of low molecular weight compounds by {MALDI}
               imaging mass spectrometry - A tutorial review",
  author    = "Rzagalinski, Ignacy and Volmer, Dietrich A",
  journal   = "Biochim. Biophys. Acta",
