@ARTICLE{Jessup2022-ln,
  title     = "{Scope2Screen}: Focus+context techniques for pathology tumor
               assessment in multivariate image data",
  author    = "Jessup, Jared and Krueger, Robert and Warchol, Simon and Hoffer,
               John and Muhlich, Jeremy and Ritch, Cecily C and Gaglia, Giorgio
