@ARTICLE{Bastrup2019-kx,
  title    = "Dual strategy for reduced signal-suppression effects in
              matrix-assisted laser desorption/ionization mass spectrometry
              imaging",
  author   = "Bastrup, Joakim and Birkelund, Svend and Asuni, Ayodeji A and
