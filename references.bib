@PHDTHESIS{Yu2006-jr,
  author   = "Yu, Fayou",
  address  = "Saarbrücken",
  abstract = "Cell-surface interactions are fundamental aspects to understand
              the role of surface chemistry and topography of biomaterials. If
              cells differ in their response to topographic variations, this
              phenomenon may be exploited to regulate cell functions and to
              design implant materials. Cell responses to surface topography,
