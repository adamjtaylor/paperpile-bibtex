}

@ARTICLE{Castro-Perez2014-ed,
  title    = "In vivo isotopically labeled atherosclerotic aorta plaques in
              {ApoE} {KO} mice and molecular profiling by matrix-assisted laser
              desorption/ionization mass spectrometric imaging",
  author   = "Castro-Perez, Jose and Hatcher, Nathan and Karikari, Nana Kofi and
