@ARTICLE{Kouzel2017-we,
  title    = "Infrared {MALDI} mass spectrometry imaging of {TLC}-separated
              glycosphingolipids with emphasis on Shiga toxin receptors isolated
              from human colon epithelial cells",
  author   = "Kouzel, Ivan U and Soltwisch, Jens and Pohlentz, Gottfried and
