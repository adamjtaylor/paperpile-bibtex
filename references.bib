@ARTICLE{Yang2010-gf,
  title     = "Polymer surface functionalities that control human embryoid body
               cell adhesion revealed by high throughput surface
               characterization of combinatorial material microarrays",
  author    = "Yang, Jing and Mei, Ying and Hook, Andrew L and Taylor, Michael
