@ARTICLE{Van_Geenen2020-st,
  title     = "Laser Ablation Electrospray Ionization Hydrogen/Deuterium
               Exchange Ambient Mass Spectrometry Imaging",
  author    = "van Geenen, Fred A M G and Claassen, Frank W and Franssen,
