  language = "en"
}

@ARTICLE{Green2009-lj,
  title    = "Developing repeatable measurements for reliable analysis of
              molecules at surfaces using desorption electrospray ionization",
  author   = "Green, F M and Stokes, P and Hopley, C and Seah, M P and Gilmore,
