@ARTICLE{Fincher2017-xp,
  title     = "Enhanced sensitivity and metabolite coverage with remote laser
               ablation electrospray ionization-mass spectrometry aided by
               coaxial plume and gas dynamics",
  author    = "Fincher, Jarod A and Korte, Andrew R and Reschke, Brent and
