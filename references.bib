  language = "en"
}

@ARTICLE{Rivas-Ubach2018-ou,
  title    = "Moving beyond the van Krevelen Diagram: A New Stoichiometric
              Approach for Compound Classification in Organisms",
  author   = "Rivas-Ubach, Albert and Liu, Yina and Bianchi, Thomas S and Tolić,
