}

@ARTICLE{Chang2010-qy,
  title    = "Tissue-specific calibration of extracellular matrix material
              properties by transforming growth factor-β and {Runx2} in bone is
              required for hearing",
  author   = "Chang, Jolie L and Brauer, Delia S and Johnson, Jacob and Chen,
