  language = "en"
}

@ARTICLE{Flint2020-iy,
  title     = "Characterization of an Aggregated Three-Dimensional Cell Culture
               Model by Multimodal Mass Spectrometry Imaging",
  author    = "Flint, Lucy E and Hamm, Gregory and Ready, Jose and Ling,
