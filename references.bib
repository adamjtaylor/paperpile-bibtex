  year     =  2004,
  keywords = "Derivatization; Design of experiments; Extraction; Mass
              spectrometry; Metabolomics"
}

@ARTICLE{Wiklund2008-hw,
  title     = "Visualization of {GC}/{TOF}-{MS}-Based Metabolomics Data for
