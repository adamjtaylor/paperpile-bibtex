  journal  = "J. Biol. Chem.",
  volume   =  277,
  number   =  4,
  pages    = "2695--2701",
  abstract = "The transcription factor RUNX2 (Cbfa1/AML3/Pebp2alphaA) is a
              critical regulator of osteoblast differentiation. We investigated
              the effect of the inflammatory cytokine tumor necrosis factor
              alpha (TNF) on the expression of RUNX2 because TNF is known to
