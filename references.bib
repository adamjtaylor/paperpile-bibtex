@ARTICLE{Bednarik2014-xl,
  title    = "Rapid Matrix-Assisted Laser Desorption/Ionization Time-of-Flight
              Mass Spectrometry Imaging with Scanning Desorption Laser Beam",
  author   = "Bednarik, Antonin and Kuba, Pavel and Moskovets, Eugene and
