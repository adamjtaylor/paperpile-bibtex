  author   = "Sidney, Laura E and Kirkham, Glen R and Buttery, Lee D K",
  journal  = "Stem Cells Dev.",
  abstract = "There are well-established approaches for osteogenic
              differentiation of embryonic stem cells (ESCs), but few show
              direct comparison with primary osteoblasts or demonstrate
              differences in response to external factors. Here, we show
              comparative analysis of in vitro osteogenic differentiation of
