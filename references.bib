@ARTICLE{Brink2014-yf,
  title    = "Post-acquisition analysis of untargeted accurate mass quadrupole
              time-of-flight {MSE} data for multiple collision-induced neutral
              losses and fragment ions of glutathione conjugates",
  author   = "Brink, Andreas and Fontaine, Fabien and Marschmann, Michaela and
