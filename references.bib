@ARTICLE{Loewenthal2009-bo,
  title     = "Donor-derived brain tumor following neural stem cell
               transplantation in an ataxia telangiectasia patient",
  author    = "Loewenthal, Ron and Scheithauer, Bernd W and Cohen, Yoram and
               Rechavi, Gideon and Hirshberg, Abraham and Amariglio, Ninette and
