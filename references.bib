@ARTICLE{Bielby2004-xx,
  title    = "In vitro differentiation and in vivo mineralization of osteogenic
              cells derived from human embryonic stem cells",
  author   = "Bielby, Robert C and Boccaccini, Aldo R and Polak, Julia M and
