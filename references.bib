@ARTICLE{Tang2013-ud,
  title    = "{MT1}-{MMP}-dependent control of skeletal stem cell commitment via
              a β1-integrin/{YAP}/{TAZ} signaling axis",
  author   = "Tang, Yi and Rowe, R Grant and Botvinick, Elliot L and Kurup,
