@ARTICLE{Wiseman2008-ek,
  title     = "Desorption electrospray ionization mass spectrometry: Imaging
               drugs and metabolites in tissues",
  author    = "Wiseman, Justin M and Ifa, Demian R and Zhu, Yongxin and
