@ARTICLE{Arumugaswamy2000-ew,
  title    = "Encapsulation of probiotic bacteria with alginate-starch and
              evaluation of survival in simulated gastrointestinal conditions
              and in yoghurt",
  author   = "Arumugaswamy, R and Reynolds, N and Sultana, K and Godward, G and
