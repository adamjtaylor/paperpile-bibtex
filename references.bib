@ARTICLE{Qiao2014-lq,
  title    = "Electrostatic Spray Ionization Mass Spectrometry Imaging",
  author   = "Qiao, Liang and Tobolkina, Elena and Lesch, Andreas and
              Bondarenko, Alexandra and Zhong, Xiaoqin and Liu, Baohong and
              Pick, Horst and Vogel, Horst and Girault, Hubert H",
  journal  = "Anal. Chem.",
  volume   =  86,
  number   =  4,
  pages    = "2033--2041",
  abstract = "Imaging samples on a surface by mass spectrometry (MS) requires
