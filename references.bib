@ARTICLE{Allaway2018-fy,
  title     = "Abstract 4643: Drug-Target Explorer: An interactive tool for
               examining chemical-biological interactions",
  author    = "Allaway, Robert J and Gosline, Sara J and Nievo, Marco and La
