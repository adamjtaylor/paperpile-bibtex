@ARTICLE{Sottile2007-md,
  title    = "Bone marrow as a source of stem cells and germ cells? Perspectives
              for transplantation",
  author   = "Sottile, Virginie",
  journal  = "Cell Tissue Res.",
  volume   =  328,
  number   =  1,
  pages    = "1--5",
  abstract = "Recent publications have suggested the existence of germ stem
              cells in the mouse at postnatal stages. The mechanism of de novo
              oocyte formation is proposed to involve a contribution from the
              bone marrow to the germ cell pool, via the bloodstream. Critical
