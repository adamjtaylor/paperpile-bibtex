@ARTICLE{Kros2007-ap,
  title    = "A model for mammalian cochlear hair cell differentiation in vitro:
              effects of retinoic acid on cytoskeletal proteins and potassium
              conductances",
  author   = "Kros, C J and Rivolta, Marcelo N and Holley, M C and Helyer, R and
