@ARTICLE{Forbes2013-ul,
  title    = "Desorption electro-flow focusing ionization of explosives and
              narcotics for ambient pressure mass spectrometry",
  author   = "Forbes, Thomas P and Brewer, Tim M and Gillen, Greg",
