@ARTICLE{De_Maar2020-ip,
  title    = "Spatial heterogeneity of nanomedicine investigated by multiscale
              imaging of the drug, the nanoparticle and the tumour environment",
  author   = "de Maar, Josanne Sophia and Sofias, Alexandros Marios and Porta
              Siegel, Tiffany and Vreeken, Rob J and Moonen, Chrit and Bos,
