@ARTICLE{Heijs2020-mq,
  title    = "Molecular signatures of tumor progression in myxoid liposarcoma
              identified by {N}-glycan mass spectrometry imaging",
  author   = "Heijs, Bram and Holst-Bernal, Stephanie and de Graaff, Marieke A
              and Briaire-de Bruijn, Inge H and Rodriguez-Girondo, Mar and van
