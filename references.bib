@ARTICLE{Green2010-tl,
  title     = "Static {SIMS–VAMAS} interlaboratory study for intensity
               repeatability, mass scale accuracy and relative quantification",
  author    = "Green, F M and Gilmore, I S and Lee, J L S and Spencer, S J and
