@ARTICLE{Rosenthal2019-vq,
  title    = "Neoantigen-directed immune escape in lung cancer evolution",
  author   = "Rosenthal, Rachel and Cadieux, Elizabeth Larose and Salgado,
              Roberto and Bakir, Maise Al and Moore, David A and Hiley, Crispin
              T and Lund, Tom and Tanić, Miljana and Reading, James L and Joshi,
              Kroopa and Henry, Jake Y and Ghorani, Ehsan and Wilson, Gareth A
              and Birkbak, Nicolai J and Jamal-Hanjani, Mariam and Veeriah,
