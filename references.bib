@ARTICLE{Jiang2015-ic,
  title    = "{MALDI}-Mass Spectrometric Imaging Revealing Hypoxia-Driven Lipids
              and Proteins in a Breast Tumor Model",
  author   = "Jiang, Lu and Chughtai, Kamila and Purvine, Samuel O and
