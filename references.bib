@MISC{Khatiwala2009-kj,
  title        = "Open Access Dissertation - {ProQuest}",
  author       = "Khatiwala, Chirag Bharat",
  abstract     = "Tissue engineering has emerged as a viable therapeutic
                  modality that can replace damaged or diseased tissue; however,
                  any successful effort to develop functional engineered tissues
                  must consider the underlying fundamental cell biology in order
                  to understand and manipulate the signals required for normal
                  development and function. In context of bone development and
                  adaptation, mechanical cues communicated via the extracellular
                  matrix (ECM) may be equally as important as chemical cues and
                  required for both homeostasis and proper bone development. The
                  studies described in this thesis are focused on deciphering
                  the influence of the intrinsic mechanical and chemical
                  properties of the microenvironment on pre-osteoblastic cell
                  phenotype, and provide a potential molecular mechanism whereby
                  changes in ECM rigidity are transduced into functional changes
                  in gene expression and osteogenic differentiation. To test the
                  hypothesis that ECM rigidity regulates pre-osteoblastic
                  MC3T3-E1 cell phenotype, two biomaterial systems in which
                  mechanical and chemical properties could be tuned
                  independently were adapted. On the surface of type-I collagen
                  functionalized polyacrylamide hydrogels, proliferation,
                  migration rate, and expression of focal adhesion-associated
                  proteins in MC3T3-E1s were found to increase with increasing
                  ECM stiffness. Furthermore, ECM compliance also regulated the
                  state of actin contractility (assessed via F-actin bundling).
                  On the surface of poly(ethylene) glycol hydrogels
                  functionalized using the adhesion-supporting RGD peptide
                  sequence or full-length collagen, activation of
                  mitogen-activated protein kinase (MAPK) and differentiation of
                  MC3T3-E1s towards a mature osteoblastic phenotype was found to
                  increase with increasing ECM rigidity. Finally, the role of
                  RhoA as a mechanosensor was investigated as RhoA has been
                  widely implicated in integrin-mediated signaling and
                  mechanotransduction. Inhibition of RhoA and ROCK
                  (Rho-associated protein kinase) in MC3T3-E1 cells reduced the
                  activities of MAPK and RUNX2 (a potent osteogenic
                  transcription factor) and delayed the onset of osteogenesis,
                  implicating that ECM rigidity regulates osteogenesis via a
                  mechanism involving MAPK activation downstream of the
                  RhoA-ROCK signaling pathway. In summary, these data emphasize
                  the importance of ECM mechanics and chemistry in the
                  regulation of osteogenesis, and contribute to a better
                  understanding of the signaling mechanisms responsible for
                  linking changes in ECM compliance to changes in cellular
                  phenotype, thus bringing engineered bone using injectable ECM
                  analogs closer to a clinical reality.",
  month        =  may,
  year         =  2009,
  howpublished = "\url{http://proquest.umi.com/pqdlink?Ver=1\&Exp=03-10-2016\&FMT=7\&DID=1619421101\&RQT=309\&attempt=1\&cfc=1}",
  note         = "Accessed: 2016-8-4"
}

