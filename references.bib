  year     =  2014
}

@ARTICLE{Jaschinski2014-fe,
  title    = "Matrix-free single-cell {LDI}-{MS} investigations of the diatoms
              Coscinodiscus granii and Thalassiosira pseudonana",
  author   = "Jaschinski, Tino and Helfrich, Eric Jan Nikolaus and Bock,
