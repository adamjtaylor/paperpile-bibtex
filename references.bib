@ARTICLE{Liu2019-gz,
  title    = "Imaging of Polar and Nonpolar Species Using Compact Desorption
              Electrospray Ionization/Postphotoionization Mass Spectrometry",
  author   = "Liu, Chengyuan and Qi, Keke and Yao, Lei and Xiong, Ying and
