@ARTICLE{Eling2020-ph,
  title    = "cytomapper: an {R}/Bioconductor package for visualisation of
              highly multiplexed imaging data",
  author   = "Eling, Nils and Damond, Nicolas and Hoch, Tobias and Bodenmiller,
