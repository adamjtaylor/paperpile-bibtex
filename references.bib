  month     =  apr,
  year      =  2008
}

@ARTICLE{El_Haj2008-zi,
  title    = "Selective activation of mechanosensitive ion channels using
              magnetic particles",
  author   = "el Haj, Alicia J and Dobson, Jon and Hughes, Steven and McBain,
