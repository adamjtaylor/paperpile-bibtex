  journal  = "BIOCHIMICA ET BIOPHYSICA ACTA-PROTEINS AND PROTEOMICS",
  volume   =  1865,
  number   =  7,
  pages    = "768--775",
  abstract = "The open-source and cross-platform software CycloBranch was
