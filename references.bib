  journal  = "Int. J. Ion Mobil. Spectrom.",
  volume   =  16,
  number   =  1,
  pages    = "41--50",
  abstract = "Ion mobility-mass spectrometry is often applied to the structural
              elucidation of multiprotein assemblies in cases where X-ray
