@ARTICLE{Van_Valen2016-bz,
  title    = "Deep Learning Automates the Quantitative Analysis of Individual
              Cells in Live-Cell Imaging Experiments",
  author   = "Van Valen, David A and Kudo, Takamasa and Lane, Keara M and
              Macklin, Derek N and Quach, Nicolas T and DeFelice, Mialy M and
