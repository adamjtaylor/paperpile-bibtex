@ARTICLE{Kim2017-ng,
  title     = "Decellularized extracellular matrix: a step towards the next
               generation source for bioink manufacturing",
  author    = "Kim, Byoung Soo and Kim, Hyeonji and Gao, Ge and Jang, Jinah and
