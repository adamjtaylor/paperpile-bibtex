@ARTICLE{Sikora2016-es,
  title     = "Size and ζ-Potential Measurement of Silica Nanoparticles in Serum
               Using Tunable Resistive Pulse Sensing",
  author    = "Sikora, Aneta and Shard, Alexander G and Minelli, Caterina",
  journal   = "Langmuir",
