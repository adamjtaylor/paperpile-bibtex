@ARTICLE{Kohlberger2019-jy,
  title     = "Whole-Slide Image Focus Quality: Automatic Assessment and Impact
               on {AI} Cancer Detection",
  author    = "Kohlberger, Timo and Liu, Yun and Moran, Melissa and Chen,
               Po-Hsuan Cameron and Brown, Trissia and Hipp, Jason D and Mermel,
