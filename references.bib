  journal   = "Tissue Eng. Part A",
  publisher = "Mary Ann Liebert, Inc.",
  abstract  = "It was hypothesized that previously optimized serum-free culture
               conditions for juvenile bovine chondrocytes could be adapted to
               generate engineered cartilage with physiologic mechanical
               properties in a preclinical, adult canine model. Primary or
               passaged (using growth factors), adult chondrocytes from three
               canines were encapsulated in agarose, and cultured in serum-free
