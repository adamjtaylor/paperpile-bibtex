@ARTICLE{Djidja2014-tb,
  title    = "Identification of Hypoxia-Regulated Proteins Using {MALDI}-Mass
              Spectrometry Imaging Combined with Quantitative Proteomics",
  author   = "Djidja, Marie-Claude and Chang, Joan and Hadjiprocopis, Andreas
              and Schmich, Fabian and Sinclair, John and Mrsnik, Martina and
